{
  "name": "chess-review-coach-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/reset-dev-lock.mjs && next dev --port ${PORT:-3000}",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:api": "node scripts/check-api-contract.mjs",
    "dev:clean": "rm -rf .next && next dev --port ${PORT:-3000}",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-chessboard": "5.12.1",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  },
  "license": "MIT"
}
