# 复制为 .env 后按需修改：cp .env.example .env
# 所有变量都有默认值，不配置也能运行（未配置 DEEPSEEK_API_KEY 时只显示引擎分析与规则说明）。

# ---------- Stockfish ----------
# 留空则自动查找：backend/engine/bin/stockfish，然后才是 $PATH 中的 stockfish。
STOCKFISH_PATH=
# 0 表示自动（CPU 核数的一半，上限由 ENGINE_MAX_THREADS 控制）。
STOCKFISH_THREADS=0
ENGINE_MAX_THREADS=4
STOCKFISH_HASH_MB=64

# ---------- 两遍分析预算 ----------
# 第一遍：所有局面，MultiPV=1，便宜快速。
PASS1_DEPTH=12
# >0 时用节点数代替深度限制，总耗时更可预测。
PASS1_NODES=0
# 第二遍：只对关键局面做深入分析。
PASS2_DEPTH=18
PASS2_MULTIPV=3
PASS2_NODES=0
# 单个局面的硬性时间上限（秒）。
POSITION_TIMEOUT=25

# 复盘页面展示的关键局面数量上限。
MAX_CRITICAL_MOMENTS=5

# ---------- 题目训练 ----------
# 做题时给「你实际走的那一步」打分用的深度。比复盘浅：这是即时反馈，本地要等得起。
GRADE_DEPTH=12

# ---------- DeepSeek（可选，详细步骤见 README 第 3 章）----------
# 不填 = 完全跳过 LLM：仍然可以看到完整引擎复盘 + 规则模板说明，功能不受影响。
#
# 填法：把 sk-xxxx 换成你在 https://platform.deepseek.com 创建的密钥。
#   * 等号右边到行尾就是密钥，前后不要加引号、空格、分号或 export
#   * 改完必须重启后端才生效（前端不用重启）
#   * 填完到首页点「测试 AI 连接」验证是否真的可用
DEEPSEEK_API_KEY=
# 换其它 OpenAI 兼容服务时改这两个：只写到域名（或域名+/v1），不要带 /chat/completions
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 需要代理才能访问外网时填这里（会导出成 HTTPS_PROXY 供 httpx 使用）：
HTTPS_PROXY=
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000

# ---------- 存储 ----------
# 相对路径基于 backend/ 目录解析。
DATABASE_URL=sqlite:///data/chess_coach.db

# ---------- HTTP ----------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
